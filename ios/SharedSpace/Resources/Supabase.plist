<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- PLACEHOLDERS ONLY. Don't put real keys in this file: it is committed to git.
     Put your real values in Supabase.local.plist next to this file (same keys). Git ignores that
     file, and a build step copies it over this one inside the app.
     Use the Project URL and the anon / publishable key only. Never the service_role / secret key.
     While there are only placeholders, the app runs on this device only (no sharing). -->
<plist version="1.0">
<dict>
	<key>SUPABASE_URL</key>
	<string>https://YOUR-PROJECT.supabase.co</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>YOUR-ANON-KEY</string>
	<key>WEB_BASE_URL</key>
	<string>https://YOUR-SITE.netlify.app</string>
</dict>
</plist>
